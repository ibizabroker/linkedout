{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    "node_modules/**",
    ".cursor/**",
    ".tmp/**",
    ".impeccable/**",
    "bun.lock"
  ],
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
