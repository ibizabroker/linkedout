{
  "name": "linkedout",
  "version": "1.0.0",
  "private": true,
  "description": "Hide LinkedIn jobs you've applied to, viewed or saved, skip reposts and crowded posts, block companies, and track applications.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint . && bun lint/no-yaml-comments.js",
    "lint:fix": "oxlint --fix .",
    "format": "oxlint --fix . && oxfmt .",
    "format:check": "oxfmt --check .",
    "verify:control": "bun .cursor/skills/verify-linkedout/bin/control-linkedout.ts",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.75.0",
    "radix-ui": "^1.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "linkedom": "^0.18.12",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "web-ext": "^10.5.0",
    "wxt": "^0.21.3"
  }
}
