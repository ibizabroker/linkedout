{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react"],
  "jsPlugins": ["./lint/no-comments.js"],
  "rules": {
    "local/no-comments": "error"
  },
  "env": {
    "browser": true,
    "webextensions": true
  },
  "ignorePatterns": [
    ".output/**",
    ".wxt/**",
    "node_modules/**",
    ".cursor/**",
    ".tmp/**"
  ]
}
